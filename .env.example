# Beispiel-Umgebung — wird im Container nach /opt/tradingagents/.env kopiert.
# In der Praxis bequem über die Web UI (Schritt 1) pflegen statt manuell.
# Nur EINEN LLM-Provider + Key setzen; Rest kann leer bleiben.

# --- LLM-Provider (einer reicht) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# --- Marktdaten (optional, teils Pflicht je nach Analyst) ---
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# --- Vorauswahl (überspringt CLI-Abfragen / Web-UI-Defaults) ---
TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.6
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.6-mini
#TRADINGAGENTS_LLM_BACKEND_URL=http://localhost:11434/v1
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_CHECKPOINT_ENABLED=false
