[Unit]
Description=TradingAgents Web UI (Proxmox LXC wrapper)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tradingagents/webui
EnvironmentFile=-/opt/tradingagents/.env
Environment=TA_BASE_DIR=/opt/tradingagents
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tradingagents/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
